{
  "_SETUP": "Effectiveness runs on other_domains_data/{books,movies}/{dirty,clean}.csv. At most 10000 rows per domain, native rate plus 5/10/20% when the native rate is higher. A case-only difference is not an error. Horizon FDs are mined once from each domain's full clean table. The published movie archive contains the crawl dirty table. movies/clean.csv and the movie experiment samples are built locally from the IMDb non-commercial datasets.",
  "paths": {
    "baselines_dir": "../baselines",
    "datasets_dir": "../../other_domains_data",
    "results_dir": "./results_other_domains",
    "experiment_datasets_dir": "./experiment_datasets_other_domains",
    "manuscript_results_dir": "../manuscript_results_other_domains"
  },
  "dataset": {
    "id_column": "id",
    "data_columns": [
      "title",
      "author",
      "isbn",
      "date_published",
      "publisher",
      "number_of_pages",
      "director",
      "actor",
      "duration",
      "genre"
    ],
    "domains": {
      "books": [
        "title",
        "author",
        "isbn",
        "date_published",
        "publisher",
        "number_of_pages"
      ],
      "movies": [
        "title",
        "director",
        "actor",
        "date_published",
        "duration",
        "genre"
      ]
    }
  },
  "systems": {
    "raha": {
      "enabled": true,
      "labeling_budget": 20,
      "task": "detection"
    },
    "baran": {
      "enabled": true,
      "labeling_budget": 20,
      "task": "correction"
    },
    "datawig": {
      "enabled": true,
      "confidence_threshold": 0.5,
      "num_training_samples": 20,
      "task": "both"
    },
    "holoclean": {
      "enabled": true,
      "db_name": "holo",
      "db_user": "holocleanuser",
      "db_pwd_env": "HOLOCLEAN_DB_PWD",
      "db_host": "127.0.0.1",
      "db_port": "5432",
      "epochs": 10,
      "threads": 1,
      "task": "both"
    },
    "horizon": {
      "enabled": true,
      "algo": 2,
      "jar": "../baselines/horizon/commons-collections4-4.3.jar",
      "src_dir": "../baselines/horizon/src",
      "task": "both"
    },
    "uniclean": {
      "enabled": true,
      "single_max": 10000,
      "spark_memory": "8g",
      "spark_partitions": 8,
      "spark_executor_memory": "8g",
      "spark_driver_memory": "8g",
      "uniclean_dir": "../baselines/uniclean/uniclean_cleaners",
      "task": "both"
    },
    "glocks": {
      "enabled": true,
      "use_batch_api": true,
      "llm_package": "google",
      "modelname": "gemini-2.5-flash-lite",
      "base_url": "",
      "api_key_env": "GOOGLE_API_KEY",
      "glocks_dir": "../baselines/glocks/pci-llm-toolkit/error-detection-cleaning-llm/code",
      "prompt_file": "../prompts/glocks/prompt_other_domains.json",
      "detection_prompt_id": "p21",
      "correction_prompt_id": "p22",
      "max_threads": 10,
      "task": "both",
      "prompt_id_map": {
        "books": {"detection": "p21", "correction": "p22"},
        "movies": {"detection": "p23", "correction": "p24"}
      }
    },
    "katara": {
      "enabled": true,
      "kb_dir": "../baselines/katara/dominSpecific",
      "type_coverage": 0.2,
      "pair_coverage": 0.15,
      "ignore_case": true,
      "task": "both"
    },
    "zerodccorrection": {
      "enabled": true,
      "zerodccorrection_dir": "../baselines/ZeroDCcorrection/ZeroDCcorrection",
      "human_repair_num": 20,
      "api_key_env": "GOOGLE_API_KEY",
      "task": "correction",
      "_note": "Oracle detection + LLM correction. Model is set inside ZeroDCcorrection/correction.py (gemini-2.5-flash-lite). Enable when ready to spend API budget; do not flip on casually."
    }
  },
  "effectiveness": {
    "sample_size": 10000,
    "error_rates": [0.05, 0.1, 0.2]
  },
  "experiment": {
    "time_limit_seconds": 36000,
    "memory_limit_fraction": 0.8,
    "n_effectiveness_runs": 3
  }
}
