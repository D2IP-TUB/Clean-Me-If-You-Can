    "katara": {
      "enabled": true,
      "kb_dir": "../baselines/katara/dominSpecific",
      "type_coverage": 0.2,
      "pair_coverage": 0.15,
      "ignore_case": true,
      "task": "both",
      "note": "Domain-specific KATARA (REDS SimplifiedPatternDiscovery). Type coverage > 0.2, pair coverage >= 0.15. Pair repairs come from the KB subject→object map."
